# ============================================================
# Database
# ============================================================
# Leave empty or comment out to use local SQLite (recommended for llama.cpp)
# DATABASE_URL=sqlite+pysqlite:///./data/daily_reports.db

# Or use PostgreSQL (Docker Compose sets this automatically):
# DATABASE_URL=postgresql+psycopg://report_agent:report_agent_password@localhost:5434/daily_reports

# ============================================================
# LLM – local llama.cpp / Ollama / LM Studio (OpenAI-compatible)
# ============================================================
# llama.cpp server example (default):
LLM_BASE_URL=http://localhost:8080/v1
LLM_API_KEY=local-no-key
LLM_MODEL=local-model

# Ollama example:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1

# LM Studio example:
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=lm-studio
# LLM_MODEL=local-model

# ============================================================
# LLM – OpenRouter (cloud alternative)
# ============================================================
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-your-key-here
# LLM_MODEL=openrouter/free
# (or keep the old names OPENROUTER_API_KEY / OPENROUTER_MODEL)

# ============================================================
# Gradio
# ============================================================
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860
LOG_LEVEL=INFO
